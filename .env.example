# GitHub Personal Access Token (for higher rate limits)
# Create at: https://github.com/settings/tokens
# Permissions needed: public_repo (read-only)
GITHUB_TOKEN=your_github_token_here

# Google Sheets Configuration
# Follow the setup instructions in README.md
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Path to Google service account credentials JSON file
GOOGLE_SERVICE_ACCOUNT_PATH=./credentials.json

# ========================================
# OPTIONAL: Data Enrichment APIs
# ========================================
# These are optional but highly recommended for extracting role, seniority, and company data

# OpenAI API Key (for AI analysis - Level 2 enrichment)
# Create at: https://platform.openai.com/api-keys
# Cost: ~$0.01-0.02 per user analyzed
OPENAI_API_KEY=your_openai_api_key_here

# Google Custom Search API (for LinkedIn search - Level 3 enrichment)
# Create at: https://developers.google.com/custom-search/v1/overview
# Free tier: 100 queries/day, then $5 per 1000 queries
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_SEARCH_ENGINE_ID=your_search_engine_id_here
